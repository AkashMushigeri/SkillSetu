# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Firebase Client SDK Configuration
# Firebase *web* config is a public identifier, not a secret, so these values
# are committed. Override them to point at your own Firebase project.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBYafwhkKarQs36-GehGM50b1QqZKTvzPk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=skillsetu-6e06a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=skillsetu-6e06a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=skillsetu-6e06a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=251000743509
NEXT_PUBLIC_FIREBASE_APP_ID=1:251000743509:web:b120001a772e2ca85096dc

# ---------------------------------------------------------------------------
# Google Gemini API — required for the AI features
# Server-only. Create a key at https://aistudio.google.com/apikey
# Powers: AI mock interview (live voice + scoring), dynamic skill assessments,
# resume parsing/analysis. Never expose this in browser code or commit it.
# Without a key the interview and resume features fall back to a clearly
# labelled offline rubric; skill assessment generation is unavailable.
# ---------------------------------------------------------------------------
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# Optional: additional AI providers for the live mock interview
# Providers are tried in order (openai -> gemini -> openrouter -> huggingface
# -> together) and the first with a working key is used. GEMINI_API_KEY alone
# is sufficient; these only widen the pool.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"          # also enables Whisper transcription
# OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
# HF_API_KEY="YOUR_HUGGINGFACE_API_KEY"
# TOGETHER_API_KEY="YOUR_TOGETHER_API_KEY"

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Environment indicator
NEXT_PUBLIC_ENV=development

# Local Firebase Emulator Toggle (Auth: 9099, Firestore: 8080, Data Connect: 9399)
# Set to 'true' to connect client SDK to local emulators instead of live cloud
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Set to 'true' on localhost to auto-fetch a Firebase App Check debug token
NEXT_PUBLIC_APPCHECK_DEBUG=false

# ---------------------------------------------------------------------------
# Production only (configure as Firebase App Hosting secrets, not in .env.local)
# ---------------------------------------------------------------------------
# Shared AI rate limiter. In production the AI routes FAIL CLOSED without it.
# UPSTASH_REDIS_REST_URL="YOUR_UPSTASH_REDIS_REST_URL"
# UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN"

# Firebase App Check (reCAPTCHA Enterprise); enforced automatically in production
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY="YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY"

# Required only to run POST /api/admin/seed in production
ADMIN_SEED_TOKEN=

# Enforce App Check outside production too
REQUIRE_APP_CHECK=false
