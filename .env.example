# ===========================================================================
# Frontend — Vercel
# Every NEXT_PUBLIC_* value here is shipped to the browser. Never put a secret
# in this section; the Firebase web config is designed to be public.
# ===========================================================================

# Firebase Client SDK Configuration (safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBYafwhkKarQs36-GehGM50b1QqZKTvzPk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=skillsetu-6e06a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=skillsetu-6e06a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=skillsetu-6e06a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=251000743509
NEXT_PUBLIC_FIREBASE_APP_ID=1:251000743509:web:b120001a772e2ca85096dc

# Base URL of the Render backend. No trailing slash.
# Local frontend: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Environment indicator
NEXT_PUBLIC_ENV=development

# Local Firebase Emulator Toggle (Auth: 9099, Firestore: 8080, Data Connect: 9399)
# Set to 'true' to connect client SDK to local emulators instead of live cloud
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# ===========================================================================
# Backend — Render (backend/ package)
# Server-only. Never commit real values, never prefix these with NEXT_PUBLIC_.
# Set them as Render dashboard environment variables (render.yaml declares them
# with sync: false) and, for local work only, in backend/.env (git-ignored).
# ===========================================================================

# Neon PostgreSQL connection string. Use a separate Neon project for development
# (Free allows 100 projects) so db:reset can never reach production data.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/skillsetu?sslmode=require

# Firebase service account (Firebase console -> Project settings -> Service accounts).
# FIREBASE_PRIVATE_KEY must be the full PEM including BEGIN/END lines. Paste it with
# literal \n sequences; the backend normalises them to real newlines on boot.
FIREBASE_PROJECT_ID=skillsetu-6e06a
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@skillsetu-6e06a.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Comma-separated exact origins allowed to call the API. No wildcards, no "*".
# Do not add Vercel preview origins: every preview gets a unique hostname.
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Google Gemini key for the AI routes. Create one at
# https://aistudio.google.com/apikey. When absent the AI features use their
# offline fallbacks. Must exist only on Render once the Next.js API routes are
# removed; it is still needed on Vercel until then.
GEMINI_API_KEY=

# Optional runtime tuning.
# NODE_ENV: development | test | production (Render leaves this unset by default).
# LOG_LEVEL: pino level, e.g. debug | info | warn | error.
# LOG_PRETTY: set to "true" for human-readable local logs only. Leave unset on
#   Render — pino-pretty is a devDependency and is not installed in the build.
# PORT: defaults to 3001; Render injects its own.
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Optional: point Firebase Admin at the local Auth emulator instead of production
# (e.g. 127.0.0.1:9099). Used by the development auth seeding command.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional: absolute path to the migrations directory. Leave unset in normal use;
# the runner resolves backend/migrations from an anchored location so that the
# compiled dist/ runner and the tsx runner agree.
# MIGRATIONS_DIR=/absolute/path/to/skillsetu/backend/migrations

# Required ONLY for `npm run db:reset`. db:reset drops the public schema, so it
# refuses to run unless BOTH guards pass: NODE_ENV must not be "production" AND
# this must be exactly "1". The two guards are independent on purpose — a
# mistaken NODE_ENV must never be sufficient on its own to wipe live data.
# Never set this on the Render service; Render runs db:migrate, which is additive.
# SKILLSETU_ALLOW_DESTRUCTIVE_RESET=1