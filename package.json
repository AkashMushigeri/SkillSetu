{
  "name": "skillsetu-ayush-career-bridge",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup-env.cjs",
    "predev": "node scripts/setup-env.cjs",
    "dev": "next dev",
    "prebuild": "node scripts/setup-env.cjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "deploy": "firebase deploy --only apphosting",
    "deploy:preview": "firebase apphosting:channels:deploy live",
    "db:seed": "npx tsx scripts/seed.ts",
    "emulators": "npx -y firebase-tools emulators:start --only dataconnect,auth,firestore",
    "emulators:export": "npx -y firebase-tools emulators:start --only dataconnect,auth,firestore --export-on-exit=./emulator-data",
    "deploy:dataconnect": "npx -y firebase-tools deploy --only dataconnect",
    "deploy:firestore": "npx -y firebase-tools deploy --only firestore",
    "deploy:database": "npx -y firebase-tools deploy --only dataconnect,firestore"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@skillsetu/dataconnect": "file:src/generated/dataconnect",
    "@tanstack-query-firebase/react": "^2.1.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "next": "^14.2.24",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^14.2.35",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^20.17.19",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
