{
  "name": "skillsetu-ayush-career-bridge",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.14.1 <25.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "deploy": "firebase deploy --only apphosting",
    "deploy:preview": "firebase apphosting:channels:deploy live",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:migrate:dev": "npm --prefix backend run db:migrate:dev",
    "db:seed": "npm --prefix backend run db:seed",
    "db:reset": "npm --prefix backend run db:reset",
    "db:verify": "npm --prefix backend run db:verify",
    "auth:seed:dev": "npm --prefix backend run auth:seed:dev",
    "auth:bootstrap-admin": "npm --prefix backend run auth:bootstrap-admin",
    "test:backend": "npm --prefix backend run test",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "emulators": "npx -y firebase-tools emulators:start --only dataconnect,auth,firestore",
    "emulators:export": "npx -y firebase-tools emulators:start --only dataconnect,auth,firestore --export-on-exit=./emulator-data",
    "deploy:dataconnect": "npx -y firebase-tools deploy --only dataconnect",
    "deploy:firestore": "npx -y firebase-tools deploy --only firestore",
    "deploy:database": "npx -y firebase-tools deploy --only dataconnect,firestore"
  },
  "dependencies": {
    "@skillsetu/dataconnect": "file:src/generated/dataconnect",
    "@tanstack-query-firebase/react": "^2.1.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "next": "^14.2.24",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^20.17.19",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
