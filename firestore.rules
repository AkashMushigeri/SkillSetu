rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Security Helper Functions
    // ------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isIndustry() {
      return isAuthenticated() && getUserRole() == 'INDUSTRY';
    }

    function isCollege() {
      return isAuthenticated() && getUserRole() == 'COLLEGE';
    }

    function isValidRole(role) {
      return role in ['STUDENT', 'INDUSTRY', 'COLLEGE'];
    }

    function hasTrustedRole(role) {
      return isValidRole(role)
        && request.auth.token.role == role
        && request.auth.token.userRole == role;
    }

    // ------------------------------------------------------------------
    // Users Collection: Profiles for Students, Industry Recruiters, Colleges
    // ------------------------------------------------------------------
    match /users/{userId} {
      // Profiles contain contact details and are private to their owner.
      allow get: if isOwner(userId);
      allow list: if false;

      // Create: Users can only provision their own profile with a recognized role
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && hasTrustedRole(request.resource.data.role);

      // Role changes require matching server-issued claims; UID cannot change.
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && isValidRole(request.resource.data.role)
        && (request.resource.data.role == resource.data.role
          || hasTrustedRole(request.resource.data.role));

      // Delete: Users can delete their own profile
      allow delete: if isOwner(userId);
    }

    // ------------------------------------------------------------------
    // User Roles Collection (Managed by backend Cloud Functions & Admin SDK)
    // ------------------------------------------------------------------
    match /userRoles/{userId} {
      allow read: if isOwner(userId);
      // Client-side writes disallowed; only Admin SDK / Cloud Functions can assign roles
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Pending Registrations (Queued for verification by Cloud Functions)
    // ------------------------------------------------------------------
    match /pendingRegistrations/{userId} {
      allow read: if isOwner(userId);
      // Client-side direct writes disallowed; handled via registerUserWithRole callable function
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Global notification access stays disabled until a trusted publisher
    // scopes records to their intended recipients.
    // ------------------------------------------------------------------
    match /notifications/{notificationId} {
      // No trusted recipient-scoped publisher exists yet; deny direct client access.
      allow read, write: if false;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isOwner(userId);
    }
  }
}
