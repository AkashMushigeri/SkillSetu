# TypeScript and @types/* are devDependencies, but the compiler is needed at BUILD
# time. Render sets NODE_ENV=production for this service, and npm honours that by
# omitting devDependencies -- which left backend/node_modules/.bin/tsc missing, so
# `npm run build` fell through to the global `typescript` binary in Render's runtime
# image. That foreign compiler is TypeScript 7, and it rejected backend/tsconfig.json
# with TS5108 (moduleResolution=node10 removed) and TS5102 (baseUrl removed).
#
# `include=dev` is the inverse of omit and takes precedence over it, so devDependencies
# install even when NODE_ENV=production. This lives in the repo rather than in the
# `buildCommand` on purpose: a Blueprint build command is stored as service config, so a
# change to render.yaml does not reliably reach an already-created service. Pinning the
# behaviour here makes `npm ci` correct no matter which command string runs it.
#
# This affects install-time dependency resolution only. It does not change runtime
# behaviour: NODE_ENV stays production on the service, and `npm start` reinstalls nothing.
# Note that `--omit=dev` on the command line will NOT override this, since include wins.

include=dev