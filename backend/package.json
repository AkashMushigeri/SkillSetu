{
  "name": "skillsetu-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SkillSetu API — Express backend (Render) over Neon PostgreSQL",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/backend/src/index.js",
    "db:migrate": "node dist/backend/src/db/migrate.js",
    "db:migrate:dev": "tsx src/db/migrate.ts",
    "db:seed": "node dist/backend/src/db/seed.js",
    "db:reset": "node dist/backend/src/db/reset.js",
    "db:verify": "node dist/backend/src/db/verify.js",
    "auth:seed:dev": "tsx src/scripts/seedDevAuth.ts",
    "auth:bootstrap-admin": "tsx src/scripts/bootstrapAdmin.ts --",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
